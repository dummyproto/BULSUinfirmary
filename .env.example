VITE_SUPABASE_URL=https://qobpigbzwwzpbcafilkz.supabase.co

# Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
# This key is safe to expose in client code as long as Row Level Security
# (RLS) policies are enabled on every table.
